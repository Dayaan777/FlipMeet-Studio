# dependencies
/node_modules
/.pnp
.pnp.js

# agent metadata & execution workspace
/.agents/
.agents/

# next.js build output
/.next/
/out/
/build
dist/

# vercel
/.vercel

# incremental typescript cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# env files - never commit secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# system & os metadata
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# ide & editor settings
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# security / certs
*.pem
*.key

# python bytecode
__pycache__/
*.py[cod]
*$py.class
